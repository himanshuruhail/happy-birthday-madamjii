body {
  margin: 0;
  padding: 0;
  font-family: 'Comic Sans MS', cursive, sans-serif;
  background: linear-gradient(120deg, #ff9a9e, #fad0c4);
  text-align: center;
  color: #fff;
}

.container {
  margin-top: 100px;
}

h1 {
  font-size: 3em;
  animation: pulse 2s infinite;
}

.message {
  font-size: 1.5em;
  margin: 20px 0;
}

button {
  padding: 10px 20px;
  font-size: 1.2em;
  border: none;
  border-radius: 20px;
  background-color: #ff6f91;
  color: white;
  cursor: pointer;
  transition: 0.3s;
}

button:hover {
  background-color: #ff4e71;
}

.hidden {
  display: none;
  margin-top: 30px;
}

img {
  max-width: 300px;
  border-radius: 10px;
}

@keyframes pulse {
  0% { transform: scale(1); }
  50% { transform: scale(1.05); }
  100% { transform: scale(1); }
}
